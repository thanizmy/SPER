{
  "name": "@sper/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/main.ts",
    "worker": "tsx src/workers/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @sper/shared-types build && tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@parse/node-apn": "^6.3.0",
    "@sper/shared-types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.4.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
